# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#
# Every value here stays on the server. None of it is ever sent to the panel.

# ─── Server ────────────────────────────────────────────────────────────────
# Port the panel backend listens on.
PORT=8099

# Interface to bind. Use 0.0.0.0 in Docker; 127.0.0.1 if fronted by a reverse
# proxy on the same host. Do not expose this to the internet.
HOST=0.0.0.0

# debug | info | warn | error
LOG_LEVEL=info


# ─── Navigator → backend authentication ────────────────────────────────────
# A shared bearer token. Provision the Navigator with:
#     https://panel.your.lan/?t=<PANEL_TOKEN>
# The panel stores it and strips it from the visible URL. Because RoomOS wipes
# web storage daily, the URL remains the recoverable source of truth.
#
# Generate one:  openssl rand -hex 32
#
# Set to empty to disable auth entirely (bench testing only).
PANEL_TOKEN=


# ─── Home Assistant ────────────────────────────────────────────────────────
# Base URL, no trailing slash. http:// or https://.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA → your profile → Security → Long-lived access
# tokens. Strongly recommended: create a dedicated non-admin "panel" user and
# generate the token as that user, so it is independently revocable.
HA_TOKEN=

# Set to 1 only if your HA uses a self-signed certificate that you have not
# added to the container's trust store. Prefer mounting your CA instead.
HA_INSECURE_TLS=0


# ─── Sonos ─────────────────────────────────────────────────────────────────
# Sonos, spoken to DIRECTLY on the LAN — no cloud, no OAuth, no Home
# Assistant. See docs/SONOS.md for why the local API rather than Sonos's cloud
# Control API, which cannot authorise on a device with one tab and has no
# music search at all.
#
# The IP address of ONE speaker. From any single player the backend learns the
# whole household — every zone, every group, and every other member's address
# — so this never needs to be more than one line, and a speaker being unplugged
# does not lose the system.
#
# Give it a STATIC address (a DHCP reservation on your router). This is also
# why a fixed address is documented rather than automatic discovery: SSDP
# multicast does not cross Docker's default bridge network, so discovery finds
# nothing and the failure is a blank Media screen rather than an error.
SONOS_HOST=192.168.1.51

# Set to 1 to search the network with SSDP when SONOS_HOST is empty. Useful on
# a laptop, unreliable in a container — see above.
SONOS_DISCOVERY=0

# Where the speakers should send events.
#
# Sonos pushes changes rather than being polled, which means the speakers
# connect INWARD to this backend — the only upstream in this app that does.
# The address is normally worked out by asking the kernel which of our
# addresses reached the first speaker, which is right on a multi-homed host
# and across VLANs. What it cannot see through is Docker's bridge NAT.
#
# So: on host networking, leave this empty. On a bridge network, set it to the
# Docker HOST's LAN address and publish the port. If events never arrive the
# panel says so on the Settings screen rather than quietly going stale.
SONOS_CALLBACK_HOST=

# Prerequisite, and the first thing to check when nothing appears: UPnP must be
# enabled in the Sonos app, under Settings → App Preferences → Privacy. Sonos
# ships it on, but it is a toggle, and turning it off stops every local
# integration — this one, Home Assistant's, SoCo's — dead.
#
# Leaving SONOS_HOST empty is supported: the panel still runs as a Home
# Assistant dashboard, and the Media screen explains what is missing.


# ─── Spotify (search only) ─────────────────────────────────────────────────
# Optional, and ONLY for searching. Playback runs through the Spotify account
# already linked in your Sonos app — these credentials never touch it and give
# no access to anybody's account.
#
# Create a free app at developer.spotify.com/dashboard. Any redirect URI will
# do; this uses the client-credentials flow, which is server-to-server with no
# user login and no redirect.
#
# Without these, the Search tab still searches your local Sonos library, and
# everything you have favourited in the Sonos app plays regardless.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ─── Immich ────────────────────────────────────────────────────────────────
# Base URL, no trailing slash. Include /api only if your reverse proxy needs it.
IMMICH_URL=http://immich.local:2283

# Immich → Account Settings → API Keys. Grant ONLY:
#     asset.read, album.read
# No upload, no delete, no admin.
IMMICH_API_KEY=

IMMICH_INSECURE_TLS=0


# ─── Bitfocus Companion ────────────────────────────────────────────────────
# Optional. Powers the `companion:` buttons on the Controls screen — the macro
# pages that used to live on the Room Bar itself.
#
# Base URL, no trailing slash. Companion's HTTP API listens on 8000 by
# default and has NO AUTHENTICATION, which is precisely why it is reached
# from here rather than from the page: the Navigator serves this app over
# HTTPS, and an HTTPS page may not fetch http://192.168.1.x at all.
#
# Leave empty and the rest of the Controls screen still works — key lights,
# webhooks and Home Assistant entities need nothing from this line.
COMPANION_URL=http://192.168.1.93:8000

# Key lights are NOT configured here. They are devices with names, like cast
# displays, so they live in config/dashboard.yaml under `controls.keylights`.
# Webhooks reuse HA_URL above.


# ─── Dashboard configuration ───────────────────────────────────────────────
# Path to your YAML config. Hot-reloaded on change; a syntax error keeps the
# last good config running rather than taking the panel down.
CONFIG_PATH=./config/dashboard.yaml
